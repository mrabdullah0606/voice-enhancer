# ==========================================
# VoiceForge AI — Git Ignore Configuration
# ==========================================

# Python Environments & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/venv/
backend/.venv/
venv/
.venv/
env/
ENV/
build/
dist/
*.egg-info/
.pytest_cache/

# Node.js & Next.js Builds
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
.turbo/

# Audio Data & Machine Learning Weights (Large Binaries)
backend/dataset/raw/*.wav
backend/dataset/processed/*.wav
backend/dataset/*.zip
backend/models/*.pth
backend/models/*.index
backend/models/*.onnx
!backend/dataset/raw/.gitkeep
!backend/dataset/processed/.gitkeep
!backend/models/README.md

# Environment variables & secrets
.env
.env*.local
*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# IDE & OS Metadata
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
# Windows binaries & tools
*.exe
backend/tools/
[Dd]esktop.ini
